APP_NAME="Kuajing CRM ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kuajing_v1
DB_USERNAME=kuajing
DB_PASSWORD=kuajing123

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

WEBHOOK_SHARED_SECRET=
WEBHOOK_SECRET_XIANYU=
WEBHOOK_SECRET_ZBJ=

BI_ETL_AUTO_REFRESH_ENABLED=false
BI_ETL_CRON="15 * * * *"
BI_ETL_INCREMENTAL_WINDOW_DAYS=3
BI_ETL_STAGE1_FULL_LAG_HOURS=24
BI_ETL_FAILURE_RECOVER_MODE=full
BI_ETL_AUTO_RECOVER_ENABLED=true
BI_ETL_RECOVER_CRON="25 * * * *"
BI_ETL_ALERT_ENABLED=true
BI_ETL_ALERT_PRIORITY=1

RAW_MAPPING_AUTO_ENABLED=true
RAW_MAPPING_CRON="*/2 * * * *"
RAW_MAPPING_LIMIT=100

SYNC_MANUAL_RUN_TRIGGER_ENABLED=true
PYTHON_SYNC_INTERNAL_URL=http://localhost:8100/internal/trigger/worker
SYNC_MANUAL_RUN_TRIGGER_TIMEOUT=2
SYNC_MANUAL_RUN_DISPATCH_FAILURE_MODE=mark_manual_review

FREEZE_LEGACY_SERVICE_ORDER_WRITE=true
