APP_NAME="Kuajing CRM ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kuajing_v1
DB_USERNAME=kuajing
DB_PASSWORD=kuajing123

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

WEBHOOK_SHARED_SECRET=
WEBHOOK_SECRET_XIANYU=
WEBHOOK_SECRET_ZBJ=
WEBHOOK_REQUIRE_TIMESTAMP=true
WEBHOOK_ALLOWED_DRIFT_SECONDS=300
WEBHOOK_MAX_PAYLOAD_BYTES=131072
WEBHOOK_MAX_ERROR_MESSAGE_LENGTH=1000

BI_ETL_AUTO_REFRESH_ENABLED=false
BI_ETL_CRON="15 * * * *"
BI_ETL_INCREMENTAL_WINDOW_DAYS=3
BI_ETL_STAGE1_FULL_LAG_HOURS=24
BI_ETL_FAILURE_RECOVER_MODE=full
BI_ETL_AUTO_RECOVER_ENABLED=true
BI_ETL_RECOVER_CRON="25 * * * *"
BI_ETL_ALERT_ENABLED=true
BI_ETL_ALERT_PRIORITY=1
READ_SERVICE_FROM_CANONICAL_ORDERS=false
READ_SERVICE_FROM_CANONICAL_ORDERS_FALLBACK=true
BI_ETL_SOURCE_CONNECTION=
BI_ETL_TARGET_CONNECTION=
BI_READONLY_SCHEMA=bi_readonly
BI_READONLY_USERNAME=bi_reader

RAW_MAPPING_AUTO_ENABLED=true
RAW_MAPPING_CRON="*/2 * * * *"
RAW_MAPPING_LIMIT=100

SYNC_MANUAL_RUN_TRIGGER_ENABLED=true
PYTHON_SYNC_INTERNAL_URL=http://localhost:8100/internal/trigger/worker
SYNC_MANUAL_RUN_TRIGGER_TIMEOUT=2
SYNC_MANUAL_RUN_DISPATCH_FAILURE_MODE=mark_manual_review

FREEZE_LEGACY_SERVICE_ORDER_WRITE=true
SERVICE_ORDER_DUAL_WRITE_ENABLED=true
SERVICE_ORDER_RECON_AUTO_ENABLED=true
SERVICE_ORDER_RECON_CRON="35 2 * * *"
SERVICE_ORDER_RECON_SAMPLE_LIMIT=50
